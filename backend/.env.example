# Required
DATABASE_URL=postgres://user:pass@host:5432/bandjam
JWT_SECRET=use-a-long-random-string

# Optional
PORT=3000
PGSSL=false            # set true for hosted Postgres that needs SSL (Neon, Supabase, Render)
PG_POOL_MAX=10
APP_TZ=Asia/Kolkata    # timezone used for "today" when validating booking dates

# Email (OTP)
GMAIL_USER=
GMAIL_PASS=            # Gmail App Password, not your account password

# Cloudinary (direct uploads from the app)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
